{
  "name": "pokebinder",
  "version": "1.0.0",
  "pokebinder": {
    "minNativeVersion": "1.0.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:capacitor": "ng build --configuration capacitor",
    "cap:sync": "npm run build:capacitor && npx cap sync android",
    "cap:open": "npx cap open android",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:apps-script": "node --test apps-script/code.test.mjs",
    "test:all": "npm test -- --watch=false && npm run test:apps-script"
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/service-worker": "^21.2.0",
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.2",
    "@capacitor/status-bar": "^8.0.4",
    "@capgo/capacitor-updater": "^8.54.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.30",
    "@angular/cli": "^21.2.30",
    "@angular/compiler-cli": "^21.2.0",
    "@capacitor/cli": "^8.6.2",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
